{
  "manifest_version": 2,
  "name": "__MSG_extension_name__",
  "short_name": "__MSG_extension_short_name__",
  "description": "__MSG_extension_description__",
  "version": "1.81.15",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "{4a91fcba-2377-49d1-bc23-e465df3fdd1d}",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {}
  },
  "browser_action": {
    "default_area": "navbar",
    "default_icon": {
      "16": "icons/read-aloud-16.svg",
      "32": "icons/read-aloud-32.svg"
    },
    "default_popup": "popup.html",
    "default_title": "Read Aloud"
  },
  "background": {
    "scripts": [
      "js/rxjs.umd.min.js",
      "js/defaults.js",
      "js/utils.js",
      "js/document.js",
      "js/speech.js",
      "js/tts-engines.js",
      "js/google-translate.js",
      "js/events.js",
      "js/firefox-supertonic.js",
      "js/firefox-tts.js",
      "js/firefox-fixes.js",
      "js/firefox-chatgpt-background.js"
    ],
    "persistent": true
  },
  "commands": {
    "play": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "__MSG_hotkey_play__"
    },
    "pause": {
      "suggested_key": {
        "default": "Alt+O"
      },
      "description": "__MSG_hotkey_pause__"
    },
    "stop": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "__MSG_hotkey_stop__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "js/firefox-chatgpt.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://piper.ttstool.com/*",
        "https://supertonic.ttstool.com/*"
      ],
      "js": [
        "js/firefox-page.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://piper.ttstool.com/*"
      ],
      "js": [
        "js/rxjs.umd.min.js",
        "js/messaging.js",
        "js/piper.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://supertonic.ttstool.com/*"
      ],
      "js": [
        "js/rxjs.umd.min.js",
        "js/messaging.js",
        "js/supertonic.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/read-aloud-16.svg",
    "32": "icons/read-aloud-32.svg",
    "48": "icons/read-aloud-48.svg",
    "96": "icons/read-aloud-96.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "menus",
    "identity",
    "storage",
    "tabHide",
    "https://translate.google.com/"
  ],
  "web_accessible_resources": [
    "css/*",
    "icons/*",
    "img/*",
    "js/*",
    "sound/*"
  ]
}
